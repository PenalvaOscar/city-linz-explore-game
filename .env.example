# Copy to app/.env.local and fill in from Supabase -> Project Settings -> API. Never commit .env.local.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=
# Desk development only. Any non-empty value relaxes the claim gates: distance unlimited, no GPS
# accuracy wait, 2 s dwell. Heading stays enforced and the recorded metrics are the real readings.
# Leave empty for the real gates (40 m, 60 m accuracy, 10 s dwell).
EXPO_PUBLIC_RELAXED_GATES=
# Demo only. An ISO instant the app starts at instead of the wall clock, e.g. 2026-09-12T14:00:00+02:00;
# the clock runs on from there, so countdowns tick and gem windows open and close. Drives decay, the
# season countdown and gem windows alike. Leave empty for the wall clock.
EXPO_PUBLIC_DEMO_NOW=
